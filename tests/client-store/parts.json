{
  "about": "Client store corpus. The format and every rule id are in docs/client-store.md.",
  "cases": [
    {
      "id": "empty-full",
      "why": "A store whose integrity record vouches for an empty table sends an empty full part.",
      "tag": "06498d89b593874140232729660ed9e8793f7c786f1d1df1f6fb49bfb0d21639",
      "body": "{\"full\":true,\"enabled_ahead\":0,\"records\":[],\"revoked_digests\":[]}",
      "expect": "accept"
    },
    {
      "id": "empty-partial",
      "why": "A store whose table has no matching integrity record, a wiped one for instance, sends a partial part.",
      "tag": "7c0f01f43e2a9df1e01198980e1e52752343c0a8b082c9c4f9bf10724830723d",
      "body": "{\"full\":false,\"enabled_ahead\":0,\"records\":[],\"revoked_digests\":[]}",
      "expect": "accept"
    },
    {
      "id": "typical",
      "why": "Disabled and enabled records and revoked digests, as a store writes them.",
      "tag": "647acccceee8cb96c3dbde54df55d700fd5826854b43e27054775ce0cbb53dc3",
      "body": "{\"full\":true,\"enabled_ahead\":0,\"records\":[{\"name\":\"acme\",\"state\":\"disabled\",\"version\":1791699000000001},{\"name\":\"batch-7\",\"state\":\"enabled\",\"version\":1791699000000002},{\"name\":\"legacy\",\"state\":\"disabled\",\"version\":1791699000000003}],\"revoked_digests\":[\"1111111111111111111111111111111111111111111111111111111111111111\",\"2222222222222222222222222222222222222222222222222222222222222222\"]}",
      "expect": "accept"
    },
    {
      "id": "enabled-ahead",
      "why": "A store counts the enabled records it left out for being ahead.",
      "tag": "1e5bcfd4553cedcaf0b57a039e587b3ab8df3f55116861a7c2168d002bd5cc93",
      "body": "{\"full\":true,\"enabled_ahead\":3,\"records\":[{\"name\":\"acme\",\"state\":\"disabled\",\"version\":1791699000000001}],\"revoked_digests\":[]}",
      "expect": "accept"
    },
    {
      "id": "record-limits",
      "why": "A 63-character name, and the lowest and highest record versions.",
      "tag": "1a19c461cff8e9efbe44d32313cfe4b3ca3ca379832d5fd3bbd382457e0c89e1",
      "body": "{\"full\":true,\"enabled_ahead\":0,\"records\":[{\"name\":\"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn\",\"state\":\"disabled\",\"version\":1},{\"name\":\"z\",\"state\":\"enabled\",\"version\":9007199254740991}],\"revoked_digests\":[]}",
      "expect": "accept"
    },
    {
      "id": "operator-like-name",
      "why": "The format does not know a deployment's operators. A reader accepts the part, and never applies the disable to its own operator.",
      "tag": "ef23bbedd0287568c83ceb1d43c6fd95f275d5b779aa9f306da4d068287cce6e",
      "body": "{\"full\":true,\"enabled_ahead\":0,\"records\":[{\"name\":\"operator\",\"state\":\"disabled\",\"version\":1791699000000001}],\"revoked_digests\":[]}",
      "expect": "accept"
    },
    {
      "id": "record-named-constructor",
      "why": "`constructor` is a valid name, and a trap for a reader or store that keeps records in a plain JavaScript object.",
      "tag": "b690bf494d9c817ac23d8e0e6f14f146726a15269f098eb8c2cec2220399c826",
      "body": "{\"full\":true,\"enabled_ahead\":0,\"records\":[{\"name\":\"acme\",\"state\":\"enabled\",\"version\":1791699000000002},{\"name\":\"constructor\",\"state\":\"disabled\",\"version\":1791699000000001}],\"revoked_digests\":[]}",
      "expect": "accept"
    },
    {
      "id": "names-of-digits",
      "why": "Names of digits sort by bytes: `007`, `10`, `9`.",
      "tag": "b0eaff769a6ef1e910dd5cb3af140964a1d61cb26da35801465010b73ccf3d2f",
      "body": "{\"full\":true,\"enabled_ahead\":0,\"records\":[{\"name\":\"007\",\"state\":\"disabled\",\"version\":1791699000000001},{\"name\":\"10\",\"state\":\"disabled\",\"version\":1791699000000001},{\"name\":\"9\",\"state\":\"disabled\",\"version\":1791699000000001}],\"revoked_digests\":[]}",
      "expect": "accept"
    },
    {
      "id": "unsorted-accepted",
      "why": "Readers do not depend on order: these records and digests are out of order, which a store never writes.",
