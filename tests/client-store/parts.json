      "body": "{\"full\":true,\"enabled_ahead\":0,\"records\":[{\"name\":\"batch-7\",\"state\":\"enabled\",\"version\":1791699000000002},{\"name\":\"acme\",\"state\":\"disabled\",\"version\":1791699000000001}],\"revoked_digests\":[\"2222222222222222222222222222222222222222222222222222222222222222\",\"1111111111111111111111111111111111111111111111111111111111111111\"]}",
      "expect": "accept"
    },
